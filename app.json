{
  "expo": {
    "name": "detour",
    "slug": "detour",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0d8ec8a9-d2b3-4efc-8aa3-ade7a1439ca9",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 2000
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "detour",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.jasonbuildslab.detour",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "讓你在 DETOUR 旅程中拍下沿途發現。"
      }
    },
    "android": {
      "permissions": [
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-image-picker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0d8ec8a9-d2b3-4efc-8aa3-ade7a1439ca9"
      }
    },
    "owner": "jasonbuilds-lab"
  }
}
